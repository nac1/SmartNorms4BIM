Ontology(<http://example.org/norms/valid-bathrooms-auto-classification>

Declaration(Class(:Bathroom))
SubClassOf(:Bathroom ifc:IfcSpace)
Declaration(Class(:HygienicEquipment))
EquivalentClasses(:HygienicEquipment ObjectUnionOf(:Shower :Sink :Toilet))
Declaration(Class(:Shower))
AnnotationAssertion(rdfs:label :Shower "Shower (identified via GuBIM/Uniclass)"@en)
EquivalentClasses(:Shower ObjectIntersectionOf(ObjectUnionOf(DataHasValue(props:classification_name_simple_property "Plats de dutxa") DataHasValue(props:classification_code_simple_property "Ss_40_50_30_85")) ifc:IfcElement))
Declaration(Class(:Sink))
AnnotationAssertion(rdfs:label :Sink "Sink (identified via GuBIM/Uniclass)"@en)
EquivalentClasses(:Sink ObjectIntersectionOf(ObjectUnionOf(DataHasValue(props:classification_name_simple_property "Piques") DataHasValue(props:classification_code_simple_property "Ss_40_50_12_72")) ifc:IfcElement))
Declaration(Class(:Toilet))
AnnotationAssertion(rdfs:label :Toilet "Toilet (identified via GuBIM/Uniclass)"@en)
EquivalentClasses(:Toilet ObjectIntersectionOf(ObjectUnionOf(DataHasValue(props:classification_name_simple_property "Inodors") DataHasValue(props:classification_code_simple_property "Ss_40_50_15_87")) ifc:IfcElement))
Declaration(Class(:ValidBathroom))
AnnotationAssertion(rdfs:label :ValidBathroom "ValidBathroom"@en)
EquivalentClasses(:ValidBathroom ObjectIntersectionOf(:Bathroom ObjectSomeValuesFrom(bot:containsElement :Shower) ObjectSomeValuesFrom(bot:containsElement :Sink) ObjectSomeValuesFrom(bot:containsElement :Toilet)))
Declaration(ObjectProperty(bot:containsElement))
